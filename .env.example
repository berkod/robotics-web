# Copy to .env for local dev. In production these are set in Netlify
# (Site configuration -> Environment variables), never committed here.
# See deploy.md "Environment variables" and missing-assets.md.

# --- The Blue Alliance (read at BUILD time, never sent to the browser) ---
# Deliberately NOT prefixed PUBLIC_: Astro only exposes PUBLIC_ vars to
# client-side code, and the widget fetches during the build, so the key stays
# server-side. Do not add a PUBLIC_ prefix to these.
TBA_AUTH_KEY=
TBA_TEAM_KEY=frc10262
# Defaults to the build's calendar year (FRC seasons track it). Pin to show a
# specific season, e.g. 2026.
TBA_YEAR=

# Render the widget from local sample fixtures instead of calling the API, so
# its populated state is visible without a key. Dev only — the output is
# clearly badged "Sample data" because it is NOT the team's real results.
# See src/lib/fixtures/README.md.
TBA_FIXTURES=

# --- Instagram (client-side embed, so this one is public by design) ---
PUBLIC_INSTAGRAM_EMBED_URL=
