---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="404 — Page Not Found"
  description="This page has been exterminated. Navigate back to safety."
>
  <!--
    The negative flash is scoped to this hero only, never the whole document —
    the recovery links below stay legible and clickable while it strobes.
    Cycle is 1.5s (0.67 flashes/sec), well under the 3/sec ceiling in
    WCAG 2.3.1, and it stops entirely under prefers-reduced-motion.
  -->
  <section class="negative flex min-h-[70vh] items-center justify-center bg-deep-pine px-4 py-16 sm:px-6">
    <div class="flex max-w-3xl flex-col items-center gap-8 text-center">
      <img
        src="/images/dalek.svg"
        alt="Illustration of a Dalek"
        width="220"
        height="275"
        class="dalek w-40 sm:w-56"
      />

      <div>
        <p class="font-display text-sm font-bold uppercase tracking-[0.35em] text-gold">
          Error 404
        </p>
        <h1 class="mt-3 font-display text-5xl font-bold text-white sm:text-6xl">
          Page Not Located
        </h1>
        <p class="mt-5 font-display text-2xl font-bold uppercase tracking-[0.2em] text-mint">
          Ex&#8203;ter&#8203;min&#8203;ate
        </p>
      </div>

      <p class="max-w-xl text-mint">
        The page you requested has been eliminated, relocated, or never existed
        in the first place. Our records are, regrettably, inferior.
      </p>
    </div>
  </section>

  <section class="bg-white">
    <div
      class="mx-auto flex max-w-6xl flex-col items-center gap-4 px-4 py-10 sm:flex-row sm:justify-center sm:px-6"
    >
      <a
        href="/"
        class="rounded-md bg-pine px-6 py-3 font-display font-bold text-white transition-colors hover:bg-signal"
      >
        Return to Home
      </a>
      <a
        href="/contact"
        class="rounded-md px-6 py-3 font-display font-bold text-signal underline decoration-signal underline-offset-4 transition-colors hover:text-pine"
      >
        Report a Broken Link
      </a>
    </div>

    <p class="mx-auto max-w-6xl px-4 pb-10 text-center text-xs text-deep-pine/70 sm:px-6">
      Dalek by Stijn van der Grinten from <a
        href="https://thenounproject.com/browse/icons/term/dalek/"
        target="_blank"
        rel="noopener noreferrer"
        title="Dalek Icons"
        class="underline decoration-signal underline-offset-2 hover:text-signal">Noun Project</a
      > (CC BY 3.0)
    </p>
  </section>
</Layout>

<style>
  /* The Dalek artwork is black line art; invert it so it reads on deep pine. */
  .dalek {
    filter: invert(1);
  }

  /*
    Hard cut rather than a crossfade — a film negative snaps between states.
    The parent filter composes with .dalek's, so the robot flips back to black
    during the inverted half of the cycle.
  */
  @keyframes negative-flash {
    0%,
    49.99% {
      filter: none;
    }
    50%,
    100% {
      filter: invert(1);
    }
  }

  .negative {
    animation: negative-flash 1.5s steps(1, end) infinite;
    will-change: filter;
  }

  @media (prefers-reduced-motion: reduce) {
    .negative {
      animation: none;
      filter: none;
      will-change: auto;
    }
  }
</style>
