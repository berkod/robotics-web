---
import Layout from "../layouts/Layout.astro";
import { SCHOOL_NAME, CONTACT_EMAIL, SCHOOL_ADDRESS } from "../lib/site";

const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(SCHOOL_ADDRESS)}&output=embed`;
---

<Layout
  title="Join / Contact Us"
  description="Lorem ipsum dolor sit amet — placeholder join/contact page for the team's site."
>
  <section class="bg-pine text-white">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
      <h1 class="font-display text-4xl font-bold">Join / Contact Us</h1>
      <p class="mt-3 max-w-2xl text-mint">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit — interested in
        joining, sponsoring, or just have a question? Reach out below.
      </p>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto grid max-w-6xl grid-cols-1 gap-10 px-4 py-14 sm:px-6 md:grid-cols-2">
      <div class="flex flex-col gap-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-signal">School</p>
          <p class="font-display text-xl font-bold text-deep-pine">{SCHOOL_NAME}</p>
          <p class="mt-1 text-sm text-deep-pine">{SCHOOL_ADDRESS}</p>
        </div>
        <div>
          <p class="text-xs font-semibold uppercase tracking-wide text-signal">Official Email</p>
          <a
            href={`mailto:${CONTACT_EMAIL}`}
            class="font-display text-xl font-bold text-signal underline decoration-signal underline-offset-4 hover:text-pine"
          >
            {CONTACT_EMAIL}
          </a>
        </div>
      </div>

      <iframe
        src={mapSrc}
        title={`Map of ${SCHOOL_NAME}`}
        class="h-72 w-full rounded-lg border-0 ring-1 ring-pine/10 md:h-full"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      />
    </div>
  </section>
</Layout>
