---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import ComingSoonBlock from "../components/ComingSoonBlock.astro";
import PageTeaserCard from "../components/PageTeaserCard.astro";

const robots = await getCollection("robots");
const currentRobot = robots.sort((a, b) => b.data.year - a.data.year)[0];

const tiers = [
  { name: "Platinum", count: 2 },
  { name: "Gold", count: 3 },
  { name: "Silver", count: 4 },
];

const pageTeasers = [
  {
    title: "About Us & FIRST",
    description: "Lorem ipsum dolor sit amet, consectetur adipiscing elit.",
    href: "#",
    comingSoon: true,
  },
  {
    title: "Team Leadership",
    description: "Sed do eiusmod tempor incididunt ut labore et dolore.",
    href: "#",
    comingSoon: true,
  },
  {
    title: "Our Robots",
    description: "Every season's robot — name, photo, and specs.",
    href: "/robots",
  },
  {
    title: "Outreach & Impact",
    description: "Ut enim ad minim veniam, quis nostrud exercitation.",
    href: "#",
    comingSoon: true,
  },
  {
    title: "Sponsors",
    description: "Duis aute irure dolor in reprehenderit in voluptate.",
    href: "#",
    comingSoon: true,
  },
  {
    title: "Join / Contact Us",
    description: "Excepteur sint occaecat cupidatat non proident.",
    href: "#",
    comingSoon: true,
  },
];
---

<Layout title="Home" description="Lorem ipsum dolor sit amet — placeholder homepage for the team's proof-of-concept site.">
  <section class="bg-pine text-white">
    <div class="mx-auto flex max-w-6xl flex-col items-start gap-6 px-4 py-20 sm:px-6 sm:py-28">
      <span class="rounded-full bg-gold px-3 py-1 text-xs font-semibold uppercase tracking-wide text-deep-pine">
        FRC Team #### · Proof of Concept
      </span>
      <h1 class="w-full font-display text-4xl font-bold leading-tight sm:text-6xl">
        [Team Name] Robotics
      </h1>
      <p class="w-full max-w-2xl text-lg text-mint sm:text-xl">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod
        tempor incididunt ut labore et dolore magna aliqua.
      </p>
      <div class="flex w-full flex-wrap gap-3">
        <a
          href="/robots"
          class="rounded-md bg-gold px-5 py-3 text-sm font-semibold text-deep-pine transition hover:brightness-95 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
        >
          See Our Robots
        </a>
        <a
          href="#"
          aria-disabled="true"
          class="pointer-events-none rounded-md border border-white/40 px-5 py-3 text-sm font-semibold text-white"
        >
          Join the Team (coming soon)
        </a>
      </div>
    </div>
  </section>

  <section class="bg-mint">
    <div class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-8 px-4 py-16 sm:px-6 md:grid-cols-2">
      <img
        src={currentRobot.data.photo}
        alt={`Placeholder photo for ${currentRobot.data.name}`}
        class="aspect-[4/3] w-full rounded-lg object-cover shadow-sm"
      />
      <div class="flex flex-col gap-4">
        <span class="text-sm font-semibold uppercase tracking-wide text-signal">
          {currentRobot.data.year} Robot
        </span>
        <h2 class="font-display text-3xl font-bold text-deep-pine">
          {currentRobot.data.name}
        </h2>
        <ul class="flex flex-col gap-2 text-deep-pine">
          {
            currentRobot.data.bullets.map((bullet) => (
              <li class="flex gap-2">
                <span class="mt-1 h-1.5 w-1.5 flex-none rounded-full bg-signal" aria-hidden="true" />
                <span>{bullet}</span>
              </li>
            ))
          }
        </ul>
        <a href="/robots" class="text-sm font-semibold text-signal hover:text-pine hover:underline">
          See past robots &rarr;
        </a>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <h2 class="font-display text-2xl font-bold text-pine">Explore the site</h2>
      <p class="mt-2 max-w-2xl text-sm text-deep-pine">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit — this proof-of-concept only
        builds out Home and Our Robots; the rest are placeholders for design review.
      </p>
      <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {pageTeasers.map((teaser) => <PageTeaserCard {...teaser} />)}
      </div>
    </div>
  </section>

  <section class="bg-mint">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <h2 class="font-display text-2xl font-bold text-deep-pine">Our Sponsors</h2>
      <p class="mt-2 max-w-2xl text-sm text-deep-pine">
        Placeholder tier grid — real sponsor logos land in Phase 2. See missing-assets.md.
      </p>
      <div class="mt-8 flex flex-col gap-8">
        {
          tiers.map((tier) => (
            <div>
              <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-signal">{tier.name} Tier</p>
              <div class="flex flex-wrap gap-4">
                {Array.from({ length: tier.count }).map(() => (
                  <div class="flex h-16 w-32 items-center justify-center rounded-md bg-white text-xs font-medium text-signal ring-1 ring-pine/10">
                    Sponsor Logo
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto grid max-w-6xl grid-cols-1 gap-6 px-4 py-16 sm:px-6 md:grid-cols-2">
      <div>
        <h2 class="mb-3 font-display text-xl font-bold text-pine">Match Results &amp; Awards</h2>
        <ComingSoonBlock
          label="The Blue Alliance widget"
          note="Live match history and awards will appear here automatically once wired up in Phase 2."
        />
      </div>
      <div>
        <h2 class="mb-3 font-display text-xl font-bold text-pine">Follow Along</h2>
        <ComingSoonBlock
          label="Instagram feed"
          note="An auto-refreshing grid of recent posts will appear here once wired up in Phase 2."
        />
      </div>
    </div>
  </section>
</Layout>
