---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import BlueAllianceWidget from "../components/BlueAllianceWidget.astro";

const robots = (await getCollection("robots")).sort((a, b) => b.data.year - a.data.year);
const [currentYear] = robots.map((r) => r.data.year);
---

<Layout
  title="Our Robots"
  description="Lorem ipsum dolor sit amet — placeholder robot gallery for the team's proof-of-concept site."
>
  <section class="bg-pine text-white">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
      <h1 class="font-display text-4xl font-bold">Our Robots</h1>
      <p class="mt-3 max-w-2xl text-mint">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Each season we add our
        robot's name, a photo, and three spec highlights.
      </p>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          robots.map((robot) => {
            const isCurrent = robot.data.year === currentYear;
            return (
              <article
                class:list={[
                  "flex flex-col overflow-hidden rounded-lg bg-mint shadow-sm ring-1 ring-pine/10",
                  isCurrent && "ring-2 ring-gold",
                ]}
              >
                <div class="relative">
                  <img
                    src={robot.data.photo}
                    alt={`Placeholder photo for ${robot.data.name}`}
                    class="aspect-[4/3] w-full object-cover"
                  />
                  {isCurrent && (
                    <span class="absolute right-3 top-3 rounded-full bg-gold px-3 py-1 text-xs font-semibold text-deep-pine">
                      Current season
                    </span>
                  )}
                </div>
                <div class="flex flex-1 flex-col gap-3 p-5">
                  <span class="text-sm font-semibold uppercase tracking-wide text-pine">
                    {robot.data.year}
                  </span>
                  <h2 class="font-display text-xl font-bold text-deep-pine">{robot.data.name}</h2>
                  <ul class="flex flex-col gap-2 text-sm text-deep-pine">
                    {robot.data.bullets.map((bullet) => (
                      <li class="flex gap-2">
                        <span class="mt-1.5 h-1.5 w-1.5 flex-none rounded-full bg-pine" aria-hidden="true" />
                        <span>{bullet}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
      <h2 class="font-display text-2xl font-bold text-pine">Match Results &amp; Awards</h2>
      <p class="mt-2 max-w-2xl text-sm text-deep-pine">
        Pulled automatically from The Blue Alliance — no manual updates needed.
      </p>
      <div class="mt-6 max-w-md">
        <BlueAllianceWidget variant="full" />
      </div>
    </div>
  </section>
</Layout>
