---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

// The team doesn't run sponsorship tiers — every sponsor is shown at the same
// size, ordered by name so the grid doesn't depend on content filenames.
const sponsors = (await getCollection("sponsors")).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);
---

<Layout
  title="Sponsors"
  description="Lorem ipsum dolor sit amet — placeholder sponsors page for the team's site."
>
  <section class="bg-pine text-white">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
      <h1 class="font-display text-4xl font-bold">Our Sponsors</h1>
      <p class="mt-3 max-w-2xl text-mint">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit — our team
        wouldn't be possible without the generous support of these sponsors.
      </p>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
      <div class="flex flex-wrap items-center gap-6">
        {
          sponsors.map((sponsor) => {
            const logo = (
              <img
                src={sponsor.data.logo}
                alt={sponsor.data.name}
                class="h-24 w-48 rounded-md object-contain ring-1 ring-pine/10"
              />
            );
            return sponsor.data.link ? (
              <a
                href={sponsor.data.link}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-md transition hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-signal"
                aria-label={`${sponsor.data.name} (opens in a new tab)`}
              >
                {logo}
              </a>
            ) : (
              logo
            );
          })
        }
      </div>
    </div>
  </section>
</Layout>
