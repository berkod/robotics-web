---
import { getEntry, render } from "astro:content";
import Layout from "../layouts/Layout.astro";

const entry = await getEntry("pages", "outreach");
if (!entry) throw new Error("Missing pages/outreach.md content entry");
const { Content } = await render(entry);
---

<Layout title={entry.data.title} description="Lorem ipsum dolor sit amet — placeholder Outreach & Impact page.">
  <section class="bg-pine text-white">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
      <h1 class="font-display text-4xl font-bold">{entry.data.title}</h1>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
      <div class="prose prose-headings:font-display max-w-none">
        <Content />
      </div>
    </div>
  </section>
</Layout>
