---
interface Props {
  label: string;
  note: string;
}

const { label, note } = Astro.props;
---

<div
  class="flex h-full flex-col items-center justify-center gap-2 rounded-lg border-2 border-dashed border-signal/40 bg-mint px-6 py-12 text-center"
>
  <p class="font-display text-lg font-semibold text-deep-pine">{label}</p>
  <p class="text-sm text-deep-pine">{note}</p>
</div>
