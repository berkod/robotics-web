---
/**
 * Match results and awards from The Blue Alliance.
 *
 * The fetch happens at BUILD TIME (see src/lib/blue-alliance.ts), so no TBA
 * key and no API call reach the browser — this component ships as plain HTML
 * with no client-side JavaScript at all. The tradeoff is that results refresh
 * on rebuild rather than on page load; see deploy.md "Keeping TBA results
 * fresh" for the scheduled-build setup.
 */
import { getTeamSeason } from "../lib/blue-alliance";

interface Props {
  variant?: "full" | "teaser";
}

const { variant = "full" } = Astro.props;

const season = await getTeamSeason();
const hasData = season.state === "live" || season.state === "fixtures";
const { wins, losses, ties } = season.record;
const eventCount = season.events.length;
const awardCount = season.awards.length;

const fallbackMessage =
  season.state === "error"
    ? "Live results are temporarily unavailable."
    : "Live results aren't connected yet — see missing-assets.md.";
---

<div class="h-full">
  {
    !hasData && (
      <div class="flex h-full flex-col items-center justify-center gap-2 rounded-lg border-2 border-dashed border-signal/40 bg-mint px-6 py-12 text-center">
        <p class="font-display text-lg font-semibold text-deep-pine">Match results &amp; awards</p>
        <p class="text-sm text-deep-pine">{fallbackMessage}</p>
        <a
          href={season.profileUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-1 text-sm font-semibold text-pine underline decoration-signal underline-offset-4 hover:text-deep-pine"
        >
          View on The Blue Alliance &rarr;
        </a>
      </div>
    )
  }

  {
    hasData && (
      <div class="rounded-lg bg-mint p-6">
        {season.state === "fixtures" && (
          <p class="mb-4 rounded-md bg-gold px-3 py-2 text-xs font-semibold text-deep-pine">
            Sample data — not the team's real results. Set TBA_AUTH_KEY for live results.
          </p>
        )}

        <p class="font-display text-3xl font-bold text-deep-pine">
          <span aria-hidden="true">{wins}-{losses}-{ties}</span>
          <span class="sr-only">
            {wins} wins, {losses} losses, {ties} ties
          </span>
        </p>

        {variant === "teaser" ? (
          <>
            <p class="text-sm text-deep-pine">
              Record across {eventCount} event{eventCount === 1 ? "" : "s"} in {season.year}
            </p>
            {awardCount > 0 && (
              <p class="mt-2 text-sm font-semibold text-pine">
                {awardCount} award{awardCount === 1 ? "" : "s"} won
              </p>
            )}
          </>
        ) : (
          <>
            <p class="text-sm text-deep-pine">
              Match record for the {season.year} season
              {season.record.played > 0 && <> &middot; {season.record.played} matches played</>}
            </p>

            <h3 class="mt-5 text-xs font-semibold uppercase tracking-wide text-pine">Events</h3>
            {eventCount > 0 ? (
              <ul class="mt-1 flex flex-col gap-1 text-sm text-deep-pine">
                {season.events.map((event) => (
                  <li>
                    <span class="font-semibold">{event.name}</span>
                    {event.location && <span class="text-deep-pine/80"> &middot; {event.location}</span>}
                  </li>
                ))}
              </ul>
            ) : (
              <p class="mt-1 text-sm text-deep-pine">No events yet this season.</p>
            )}

            <h3 class="mt-5 text-xs font-semibold uppercase tracking-wide text-pine">Awards</h3>
            {awardCount > 0 ? (
              <ul class="mt-1 flex flex-col gap-1 text-sm text-deep-pine">
                {season.awards.map((award) => (
                  <li>
                    <span class="font-semibold">{award.name}</span>
                    <span class="text-deep-pine/80"> &middot; {award.event}</span>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="mt-1 text-sm text-deep-pine">No awards yet this season.</p>
            )}

            <a
              href={season.profileUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-5 inline-block text-sm font-semibold text-pine underline decoration-signal underline-offset-4 hover:text-deep-pine"
            >
              Full history on The Blue Alliance &rarr;
            </a>
          </>
        )}
      </div>
    )
  }
</div>
