---
import { INSTAGRAM_LINK } from "../lib/site";

/**
 * Instagram feed via SociableKit (see design.md Decision 5). Create the widget
 * at sociablekit.com and put its embed id in PUBLIC_INSTAGRAM_EMBED_ID — the
 * team needs to sign up themselves, see missing-assets.md.
 *
 * SociableKit renders client-side rather than in an iframe: its script finds
 * `.sk-instagram-feed` by class name, reads `data-embed-id`, and injects the
 * feed. Both of those are verified against the shipped widget.js, not just its
 * docs — it uses getElementsByClassName('sk-instagram-feed').
 *
 * The important consequence is that failure here is SILENT. A blocked script,
 * a network error, or the free plan's 2,000-monthly-view cap all leave the
 * container simply empty, with no error event to hook. So the fallback starts
 * visible — which is also the correct no-JavaScript state — then hides itself
 * optimistically on load to avoid flashing, and comes back if the container is
 * still empty once the grace period is up.
 */
const embedId = import.meta.env.PUBLIC_INSTAGRAM_EMBED_ID as string | undefined;
const configured = Boolean(embedId);
const profileHref = INSTAGRAM_LINK;
const handle = profileHref.replace(/^https?:\/\/(www\.)?instagram\.com\//, "").replace(/\/$/, "");

/** How long to let the third-party script render before showing the fallback. */
const FEED_TIMEOUT_MS = 6000;
---

<div data-ig-widget class="h-full">
  <div
    data-ig-fallback
    class="flex h-full flex-col items-center justify-center gap-2 rounded-lg border-2 border-dashed border-signal/40 bg-mint px-6 py-12 text-center"
  >
    <p class="font-display text-lg font-semibold text-deep-pine">Instagram feed</p>
    <p class="text-sm text-deep-pine">
      {
        configured
          ? "The feed is temporarily unavailable."
          : "Not connected yet — see missing-assets.md."
      }
    </p>
    <a
      href={profileHref}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-1 text-sm font-semibold text-pine underline decoration-signal underline-offset-4 hover:text-deep-pine"
    >
      Follow @{handle} on Instagram &rarr;
    </a>
  </div>

  {
    configured && (
      <div
        data-ig-feed
        class="sk-instagram-feed min-h-[16rem] w-full"
        data-embed-id={embedId}
      />
    )
  }
</div>

<script define:vars={{ configured, FEED_TIMEOUT_MS }}>
  if (configured) {
    const widget = document.querySelector("[data-ig-widget]");
    const fallback = widget?.querySelector("[data-ig-fallback]");
    const feed = widget?.querySelector("[data-ig-feed]");

    if (fallback && feed) {
      // Assume it will load, so the fallback does not flash on every visit.
      fallback.classList.add("hidden");

      // SociableKit reports nothing on failure, so the only signal available
      // is whether it actually put anything in the container.
      setTimeout(() => {
        if (feed.childElementCount === 0) {
          fallback.classList.remove("hidden");
        }
      }, FEED_TIMEOUT_MS);
    }
  }
</script>

{
  configured && (
    <script is:inline defer src="https://widgets.sociablekit.com/instagram-feed/widget.js" />
  )
}
