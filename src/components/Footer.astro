---
import { CONTACT_EMAIL, BLUE_ALLIANCE_TEAM_PAGE, INSTAGRAM_LINK } from "../lib/site";

// Social links are placeholders — see missing-assets.md.
const contactEmail = CONTACT_EMAIL;
const socialLinks = [
  { label: "The Blue Alliance", href: BLUE_ALLIANCE_TEAM_PAGE },
  { label: "Instagram", href: INSTAGRAM_LINK },
];
---

<footer class="bg-deep-pine text-white">
  <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-8 sm:flex-row sm:items-center sm:justify-between sm:px-6">
    <p class="text-sm text-mint">
      <a href={`mailto:${contactEmail}`} class="underline decoration-signal underline-offset-4 hover:text-gold">
        {contactEmail}
      </a>
      <span class="mx-2 text-white/30" aria-hidden="true">·</span>
      Placeholder contact — see <code class="text-xs">missing-assets.md</code>
    </p>

    <ul class="flex gap-4 text-sm">
      {
        socialLinks.map((link) => (
          <li>
            <a
              href={link.href}
              target="_blank"
              rel="external noopener noreferrer"
              class="hover:text-gold focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
