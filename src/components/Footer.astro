---
// Contact/social values are placeholders — see missing-assets.md.
const contactEmail = "team@example.org";
const socialLinks = [
  { label: "The Blue Alliance", href: "#" },
  { label: "Instagram", href: "#" },
];
---

<footer class="bg-deep-pine text-white">
  <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-8 sm:flex-row sm:items-center sm:justify-between sm:px-6">
    <p class="text-sm text-mint">
      <a href={`mailto:${contactEmail}`} class="underline decoration-signal underline-offset-4 hover:text-gold">
        {contactEmail}
      </a>
      <span class="mx-2 text-white/30" aria-hidden="true">·</span>
      Placeholder contact — see <code class="text-xs">missing-assets.md</code>
    </p>

    <ul class="flex gap-4 text-sm">
      {
        socialLinks.map((link) => (
          <li>
            <a href={link.href} class="hover:text-gold focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
