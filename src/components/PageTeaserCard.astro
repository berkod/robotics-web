---
interface Props {
  title: string;
  description: string;
  href: string;
  comingSoon?: boolean;
}

const { title, description, href, comingSoon = false } = Astro.props;
---

<a
  href={href}
  aria-disabled={comingSoon ? "true" : undefined}
  class:list={[
    "group flex flex-col gap-2 rounded-lg bg-white p-5 shadow-sm ring-1 ring-pine/10 transition hover:-translate-y-0.5 hover:shadow-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-signal",
    comingSoon && "pointer-events-none",
  ]}
>
  <h3 class="font-display text-base font-semibold text-pine">
    {title}
    {comingSoon && <span class="ml-2 rounded-full bg-gold px-2 py-0.5 text-[11px] font-semibold text-deep-pine">Coming soon</span>}
  </h3>
  <p class="text-sm text-deep-pine">{description}</p>
</a>
